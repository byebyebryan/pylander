{
  "type": "object",
  "required": [
    "contract",
    "doctor_verdict",
    "sources",
    "summary",
    "top_findings",
    "repro_bundle",
    "probe_request",
    "next_actions",
    "created_at_utc"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "enum": [
        "telemetry_triage_report.v1"
      ]
    },
    "doctor_verdict": {
      "type": "string",
      "enum": [
        "healthy",
        "watch",
        "investigate",
        "critical"
      ]
    },
    "sources": {
      "type": "object",
      "required": [
        "benchmark_json",
        "compare_json",
        "sim_logs"
      ],
      "properties": {
        "benchmark_json": {
          "type": "string"
        },
        "compare_json": {
          "type": "string"
        },
        "sim_logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "new_global_crashes",
        "candidate_crashes",
        "sim_log_crashes",
        "notable_global_compute",
        "total_findings"
      ],
      "properties": {
        "new_global_crashes": {
          "type": "integer"
        },
        "candidate_crashes": {
          "type": "integer"
        },
        "sim_log_crashes": {
          "type": "integer"
        },
        "notable_global_compute": {
          "type": "boolean"
        },
        "total_findings": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "top_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "category",
          "title",
          "measured_evidence",
          "likely_cause",
          "confidence",
          "source_refs"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "crash",
              "perf",
              "phase",
              "debug"
            ]
          },
          "title": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "measured_evidence": {
            "type": "object"
          },
          "likely_cause": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "repro_bundle": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "probe_request": {
      "type": "object",
      "required": [
        "needed",
        "questions"
      ],
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at_utc": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
