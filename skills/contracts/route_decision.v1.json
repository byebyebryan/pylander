{
  "type": "object",
  "required": [
    "contract",
    "recommended_route",
    "confidence",
    "triggered_conditions",
    "route_rationale",
    "scores",
    "execution_plan",
    "handoff_payload",
    "created_at_utc"
  ],
  "properties": {
    "contract": {"type": "string", "enum": ["route_decision.v1"]},
    "recommended_route": {"type": "string", "enum": ["arena", "loop"]},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "triggered_conditions": {"type": "array", "items": {"type": "string"}},
    "route_rationale": {
      "type": "object",
      "required": ["measured_signals", "inferred_signals"],
      "properties": {
        "measured_signals": {"type": "array", "items": {"type": "string"}},
        "inferred_signals": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "required": ["arena", "loop"],
      "properties": {
        "arena": {"type": "number"},
        "loop": {"type": "number"}
      },
      "additionalProperties": false
    },
    "execution_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "command"],
        "properties": {
          "step": {"type": "string"},
          "command": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "handoff_payload": {
      "type": "object",
      "required": ["target_skill", "payload"],
      "properties": {
        "target_skill": {
          "type": "string",
          "enum": ["pylander-tune-arena", "pylander-tune-loop"]
        },
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "created_at_utc": {"type": "string"}
  },
  "additionalProperties": false
}
