    <script type="application/javascript">
    globalThis.__canvas_resized = (self, ecw, ech) => {
        __canvas_view = { width: ecw, height: ech };
        show_infobox();
    }
    function hide_transfer() {
        transfer.hidden = true;
        transfer.style.display = "none";
        transfer.style.visibility = "hidden";
    }
    let auto_scroll_console = false;

    function get_xterm_instance() {
        if (window.VM && window.VM.vt && window.VM.vt.xterm) {
            return window.VM.vt.xterm;
        }
        if (window.python && window.python.vt && window.python.vt.xterm) {
            return window.python.vt.xterm;
        }
        return null;
    }

    function get_xterm_cell_metrics(xterm) {
        const cell = xterm && xterm._core && xterm._core._renderService && xterm._core._renderService.dimensions && xterm._core._renderService.dimensions.css && xterm._core._renderService.dimensions.css.cell;
        if (cell && cell.width > 0 && cell.height > 0) {
            return cell;
        }

        const measure = document.querySelector("#terminal .xterm-char-measure-element");
        if (measure && measure.getBoundingClientRect) {
            const rect = measure.getBoundingClientRect();
            if (rect.width > 0 && rect.height > 0) {
                return { width: rect.width, height: rect.height };
            }
        }

        return null;
    }

    function configure_xterm_console() {
        const xterm = get_xterm_instance();
        if (!xterm || pyconsole.hidden) {
            return false;
        }

        const fontSize = 12;
        const lineHeight = 1.1;

        if (xterm.options) {
            xterm.options.fontSize = fontSize;
            xterm.options.lineHeight = lineHeight;
        } else if (typeof xterm.setOption === "function") {
            xterm.setOption("fontSize", fontSize);
            xterm.setOption("lineHeight", lineHeight);
        }

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                const usableWidth = Math.max(320, terminal.clientWidth - 12);
                const usableHeight = Math.max(160, terminal.clientHeight - 12);
                const metrics = get_xterm_cell_metrics(xterm);
                const cellWidth = metrics ? metrics.width : Math.max(7, fontSize * 0.62);
                const cellHeight = metrics ? metrics.height : Math.max(12, fontSize * 1.45);
                const cols = Math.max(40, Math.floor(usableWidth / cellWidth));
                const rows = Math.max(10, Math.floor(usableHeight / cellHeight));

                if (typeof xterm.resize === "function") {
                    xterm.resize(cols, rows);
                }
                if (typeof xterm.refresh === "function") {
                    xterm.refresh(0, Math.max(0, rows - 1));
                }
                if (auto_scroll_console) {
                    scroll_console_to_bottom();
                }
            });
        });
        return true;
    }

    function schedule_xterm_console_config(attempt = 0) {
        if (configure_xterm_console()) {
            if (auto_scroll_console) {
                scroll_console_to_bottom();
            }
            return;
        }
        if (attempt < 20) {
            setTimeout(() => schedule_xterm_console_config(attempt + 1), 250);
        }
    }

    function set_console_open(open) {
        pyconsole.hidden = !open;
        const toggle = document.getElementById("console-toggle");
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.textContent = open ? "Console: On" : "Console: Off";
        if (open) {
            setTimeout(() => schedule_xterm_console_config(), 0);
            setTimeout(() => schedule_xterm_console_config(), 100);
            if (auto_scroll_console) {
                setTimeout(scroll_console_to_bottom, 0);
                setTimeout(scroll_console_to_bottom, 100);
            }
        }
    }
    function set_console_autoscroll(enabled) {
        auto_scroll_console = enabled;
        const toggle = document.getElementById("autoscroll-toggle");
        toggle.setAttribute("aria-pressed", enabled ? "true" : "false");
        toggle.textContent = enabled ? "Auto-scroll: On" : "Auto-scroll: Off";
    }
    function scroll_console_to_bottom() {
        const viewport = document.querySelector("#terminal .xterm-viewport");
        if (viewport) {
            viewport.scrollTop = viewport.scrollHeight;
        }
    }
    async function custom_onload(debug_hidden) {
        const toggle = document.getElementById("console-toggle");
        const autoscroll_toggle = document.getElementById("autoscroll-toggle");
        set_console_open(false);
        set_console_autoscroll(false);
        system.hidden = debug_hidden;
        hide_transfer();
        info.hidden = debug_hidden;
        box.hidden = debug_hidden;
        show_infobox();
        window.addEventListener("resize", show_infobox);
        window.addEventListener("resize", () => {
            if (!pyconsole.hidden) {
                schedule_xterm_console_config();
            }
        });
        toggle.hidden = false;
        autoscroll_toggle.hidden = false;
        toggle.addEventListener("click", () => {
            set_console_open(pyconsole.hidden);
        });
        autoscroll_toggle.addEventListener("click", () => {
            set_console_autoscroll(!auto_scroll_console);
            if (auto_scroll_console && !pyconsole.hidden) {
                scroll_console_to_bottom();
            }
        });
        window.setInterval(() => {
            if (!pyconsole.hidden && auto_scroll_console) {
                scroll_console_to_bottom();
            }
        }, 500);
    }
    function custom_prerun() {}
    function custom_postrun() {
        hide_transfer();
        setTimeout(hide_transfer, 0);
        setTimeout(hide_transfer, 250);
        setTimeout(hide_transfer, 1000);
    }
    </script>

