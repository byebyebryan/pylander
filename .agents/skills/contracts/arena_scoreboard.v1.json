{
  "type": "object",
  "required": [
    "contract",
    "arena_id",
    "arena_type",
    "outcome",
    "winner_branch_id",
    "no_winner_reason",
    "branches",
    "next_step_handoff",
    "created_at_utc"
  ],
  "properties": {
    "contract": {"type": "string", "enum": ["arena_scoreboard.v1"]},
    "arena_id": {"type": "string"},
    "arena_type": {"type": "string", "enum": ["strategy", "tune"]},
    "outcome": {"type": "string", "enum": ["winner", "no_winner"]},
    "winner_branch_id": {"type": "string"},
    "no_winner_reason": {"type": "string"},
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "branch_id",
          "worker_decision",
          "passed_hard_gates",
          "hard_gate_failures",
          "rank_score",
          "summary"
        ],
        "properties": {
          "branch_id": {"type": "string"},
          "worker_decision": {"type": "string", "enum": ["promote", "iterate", "drop"]},
          "passed_hard_gates": {"type": "boolean"},
          "hard_gate_failures": {"type": "array", "items": {"type": "string"}},
          "rank_score": {"type": "number"},
          "summary": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "next_step_handoff": {
      "type": "object",
      "required": ["target_skill", "payload"],
      "properties": {
        "target_skill": {"type": "string"},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "created_at_utc": {"type": "string"}
  },
  "additionalProperties": false
}
